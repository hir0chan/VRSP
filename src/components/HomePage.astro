---
import streamsData from "../../data/generated/streams.json";
import streamersData from "../../data/generated/streamers.json";
import type { GeneratedStreams } from "../../scripts/models.js";
import Layout from "../layouts/Layout.astro";
import { classifyStreams } from "../lib/classify.js";
import type { Locale } from "../lib/i18n.js";
import { getTranslation } from "../lib/i18n.js";
import { resolveThumbnailUrl } from "../lib/thumbnail.js";
import SectionHeader from "./SectionHeader.astro";
import StreamCard from "./StreamCard.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
// generated は型付き update スクリプトだけが書き込むため、表示側では再検証しない。
const generatedStreams = streamsData as unknown as GeneratedStreams;
const sections = classifyStreams(
  generatedStreams.streams,
  streamersData.streamers,
  new Date(),
  locale,
);
const thumbnailUrl = (path: string): string =>
  resolveThumbnailUrl(path, import.meta.env.BASE_URL);
---

<Layout locale={locale} updatedAt={generatedStreams.updatedAt}>
    <script is:inline>
      // 読み込みごとにランダムで1情景を選ぶ(?scenery= で確認用に固定可)。JS 無効時は CSS 既定の山
      (() => {
        const variants = ["mountains", "portal", "city"];
        let choice = variants[Math.floor(Math.random() * variants.length)];
        try {
          const requested = new URLSearchParams(location.search).get("scenery");
          if (requested !== null && variants.includes(requested)) choice = requested;
        } catch {}
        document.documentElement.setAttribute("data-scenery", choice);
      })();
    </script>
  <section class="hero" aria-labelledby="page-title">
    <!-- ヒーロー装飾: VRChat のワールドは山も街もあらゆる情景があるため、3種からランダム表示する -->
    <svg class="hero-mountains" data-scenery-variant="mountains" viewBox="0 0 1000 320" preserveAspectRatio="xMinYMax meet" aria-hidden="true">
      <path fill="#b9d5c1" d="M-80 320 L206 88 Q236 64 266 88 L552 320 Z" />
      <path fill="#d3e4d8" d="M180 320 L556 118 Q588 92 620 118 L996 320 Z" />
    </svg>
    <svg class="hero-sky" data-scenery-variant="mountains" viewBox="0 0 420 160" preserveAspectRatio="xMaxYMin meet" aria-hidden="true">
      <circle cx="344" cy="72" r="48" fill="#f2c85c" />
      <g fill="#ffffff">
        <rect x="60" y="34" width="190" height="42" rx="21" />
        <rect x="156" y="68" width="150" height="36" rx="18" />
      </g>
    </svg>
    <svg class="hero-mountains" data-scenery-variant="portal" viewBox="0 0 1000 320" preserveAspectRatio="xMinYMax meet" aria-hidden="true">
      <ellipse cx="300" cy="306" rx="175" ry="12" fill="#dfe9e2" />
      <ellipse cx="620" cy="306" rx="105" ry="9" fill="#e6eee9" />
      <ellipse cx="620" cy="212" rx="82" ry="96" fill="#cfe0d5" />
      <ellipse cx="620" cy="212" rx="60" ry="72" fill="#e7f1fa" />
      <ellipse cx="300" cy="168" rx="132" ry="150" fill="#b9d5c1" />
      <ellipse cx="300" cy="168" rx="100" ry="116" fill="#dcebf7" />
      <ellipse
        cx="300"
        cy="168"
        rx="58"
        ry="76"
        fill="none"
        stroke="#ffffff"
        stroke-width="13"
        stroke-linecap="round"
        stroke-dasharray="150 999"
        transform="rotate(-35 300 168)"
      />
      <circle cx="452" cy="104" r="6" fill="#b9d5c1" />
      <circle cx="498" cy="66" r="4" fill="#f2c85c" />
      <circle cx="742" cy="120" r="5" fill="#cfe0d5" />
    </svg>
    <svg class="hero-sky" data-scenery-variant="portal" viewBox="0 0 420 160" preserveAspectRatio="xMaxYMin meet" aria-hidden="true">
      <circle cx="330" cy="78" r="42" fill="#f2c85c" />
      <ellipse cx="330" cy="82" rx="68" ry="16" fill="none" stroke="#e5b64e" stroke-width="9" transform="rotate(-16 330 82)" />
      <g fill="#ffffff">
        <rect x="60" y="34" width="170" height="40" rx="20" />
        <rect x="140" y="66" width="130" height="34" rx="17" />
      </g>
    </svg>
    <svg class="hero-mountains" data-scenery-variant="city" viewBox="0 0 1000 320" preserveAspectRatio="xMinYMax meet" aria-hidden="true">
      <rect x="16" y="152" width="112" height="168" rx="12" fill="#c9d6e6" />
      <rect x="148" y="88" width="132" height="232" rx="14" fill="#b9c9de" />
      <rect x="211" y="44" width="6" height="44" fill="#b9c9de" />
      <circle cx="214" cy="38" r="7" fill="#e8484e" />
      <rect x="300" y="172" width="100" height="148" rx="12" fill="#d8e2ee" />
      <rect x="420" y="118" width="122" height="202" rx="14" fill="#c3d2e4" />
      <rect x="562" y="202" width="92" height="118" rx="10" fill="#d8e2ee" />
      <g fill="#ffffff">
        <rect x="46" y="184" width="16" height="20" rx="4" />
        <rect x="82" y="184" width="16" height="20" rx="4" />
        <rect x="46" y="228" width="16" height="20" rx="4" />
        <rect x="180" y="124" width="16" height="20" rx="4" />
        <rect x="216" y="168" width="16" height="20" rx="4" />
        <rect x="180" y="212" width="16" height="20" rx="4" />
        <rect x="330" y="204" width="16" height="20" rx="4" />
        <rect x="452" y="152" width="16" height="20" rx="4" />
        <rect x="488" y="196" width="16" height="20" rx="4" />
        <rect x="592" y="232" width="16" height="20" rx="4" />
      </g>
      <rect x="216" y="124" width="16" height="20" rx="4" fill="#f2c85c" />
      <rect x="452" y="240" width="16" height="20" rx="4" fill="#f2c85c" />
    </svg>
    <svg class="hero-sky" data-scenery-variant="city" viewBox="0 0 420 160" preserveAspectRatio="xMaxYMin meet" aria-hidden="true">
      <path d="M352 30 a46 46 0 1 0 32 80 a38 38 0 1 1 -32 -80 z" fill="#f2c85c" />
      <g fill="#ffffff">
        <circle cx="240" cy="52" r="4" />
        <circle cx="286" cy="108" r="3" />
        <path d="M196 84 l5 12 12 5 -12 5 -5 12 -5 -12 -12 -5 12 -5 z" />
      </g>
    </svg>
    <p class="eyebrow">{t.heroEyebrow}</p>
    <h1 id="page-title">{t.heroTitleBeforeEmphasis}<br /><em>{t.heroTitleEmphasis}</em></h1>
    <p class="hero-copy">{t.heroCopy}</p>
  </section>

  <div class="filter-controls" hidden>
    <fieldset class="platform-filter">
      <legend>{t.platformLegend}</legend>
      <input type="radio" id="platform-all" name="platform-filter" value="all" checked />
      <label for="platform-all">{t.platformAll}</label>
      <input type="radio" id="platform-youtube" name="platform-filter" value="youtube" />
      <label for="platform-youtube">
        <svg viewBox="0 0 28.57 20" aria-hidden="true">
          <path
            fill="currentColor"
            fill-rule="evenodd"
            d="M27.973 3.123A3.578 3.578 0 0 0 25.447.597C23.22 0 14.285 0 14.285 0S5.35 0 3.123.597A3.578 3.578 0 0 0 .597 3.123C0 5.35 0 10 0 10s0 4.65.597 6.877a3.578 3.578 0 0 0 2.526 2.526C5.35 20 14.285 20 14.285 20s8.935 0 11.162-.597a3.578 3.578 0 0 0 2.526-2.526C28.57 14.65 28.57 10 28.57 10s0-4.65-.597-6.877zM11.425 14.285 18.85 10l-7.425-4.285z"
          />
        </svg>
        YouTube
      </label>
      <input type="radio" id="platform-twitch" name="platform-filter" value="twitch" />
      <label for="platform-twitch">
        <svg viewBox="0 0 2400 2800" aria-hidden="true">
          <path
            fill="currentColor"
            d="M500 0 0 500v1800h600v500l500-500h400l900-900V0H500zm1700 1300-400 400h-400l-350 350v-350H600V200h1600v1100zM1700 550h200v600h-200zm-550 0h200v600h-200z"
          />
        </svg>
        Twitch
      </label>
      <input type="radio" id="platform-niconico" name="platform-filter" value="niconico" />
      <label for="platform-niconico">
        <img class="nico-symbol" src={`${import.meta.env.BASE_URL}images/niconico-symbol.png`} alt="" width="302" height="300" />
        <img class="nico-symbol-white" src={`${import.meta.env.BASE_URL}images/niconico-symbol-white.png`} alt="" width="302" height="300" />
        {t.platformNiconico}
      </label>
    </fieldset>
    <div class="ja-only-toggle">
      <input type="checkbox" id="ja-only-toggle" />
      <label for="ja-only-toggle">{t.japaneseOnly}</label>
    </div>
  </div>

  {
    sections.live.length > 0 && (
      <section class="schedule-section" aria-labelledby="live-heading">
        <SectionHeader eyebrow="BROADCASTING NOW" title={t.liveSection} count={sections.live.length} locale={locale} />
        <div class="card-grid" id="live-heading">
          {sections.live.map((stream) => (
            <StreamCard stream={stream} thumbnailUrl={thumbnailUrl(stream.thumbnail)} locale={locale} live={true} />
          ))}
        </div>
      </section>
    )
  }

  <section class="schedule-section" aria-labelledby="today-heading">
    <SectionHeader eyebrow="TODAY IN JST" title={t.todaySection} count={sections.today.length} locale={locale} />
    {
      sections.today.length > 0 ? (
        <div class="card-grid" id="today-heading">
          {sections.today.map((stream) => (
            <StreamCard stream={stream} thumbnailUrl={thumbnailUrl(stream.thumbnail)} locale={locale} />
          ))}
        </div>
      ) : (
        <p class="empty-state" id="today-heading">{t.todayEmpty}</p>
      )
    }
  </section>

  <section class="schedule-section" aria-labelledby="upcoming-heading">
    <SectionHeader eyebrow="SAVE THE DATE" title={t.upcomingSection} locale={locale} />
    <div class="upcoming-list" id="upcoming-heading">
      {
        sections.upcoming.length > 0 ? (
          sections.upcoming.map((group) => (
            <section class="date-group">
              <h3>{group.label}</h3>
              <div class="card-grid">
                {group.streams.map((stream) => (
                  <StreamCard stream={stream} thumbnailUrl={thumbnailUrl(stream.thumbnail)} locale={locale} />
                ))}
              </div>
            </section>
          ))
        ) : (
          <p class="empty-state">{t.upcomingEmpty}</p>
        )
      }
    </div>
  </section>
</Layout>
