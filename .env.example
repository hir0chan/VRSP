# このファイルを .env にコピーして値を設定する(.env は git 管理外)
#   cp .env.example .env
# 本番(GitHub Actions)では同名の GitHub Secrets を使用する

# YouTube Data API v3 の API キー
# 取得: Google Cloud Console → YouTube Data API v3 を有効化 → 認証情報 → API キー
YOUTUBE_API_KEY=

# Twitch Developer Console で登録したアプリケーションの認証情報
# YOUTUBE_API_KEY が設定済みで、この2値が未設定の場合は YouTube のみ取得する
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
