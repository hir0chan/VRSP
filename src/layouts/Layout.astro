---
import "../styles/global.css";

interface Props {
  title: string;
  updatedAt: string;
}

const { title, updatedAt } = Astro.props;
const description =
  "VRChat系配信者のライブ配信と今後の配信予定をひとつにまとめたスケジュールポータルです。";
const siteUrl = new URL(
  import.meta.env.BASE_URL,
  Astro.site ?? "https://hir0chan.github.io",
).href;
const ogImageUrl = `${siteUrl}images/ogp.png`;
const updatedLabel = new Intl.DateTimeFormat("ja-JP", {
  timeZone: "Asia/Tokyo",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
}).format(new Date(updatedAt));
---

<!doctype html>
<html lang="ja" data-ja-only>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ぶいちゃ配信アンテナ" />
    <meta property="og:title" content="ぶいちゃ配信アンテナ" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hir0chan_vrc" />
    <meta name="twitter:title" content="ぶいちゃ配信アンテナ" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href={`${import.meta.env.BASE_URL}images/favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      // デフォルト ON(html に静的付与)。明示的に OFF("0")が保存されている場合のみ外す
      try {
        if (localStorage.getItem("vrsp-ja-only") === "0") {
          document.documentElement.removeAttribute("data-ja-only");
        }
      } catch {}
      try {
        const platform = localStorage.getItem("vrsp-platform");
        if (platform === "youtube" || platform === "twitch") {
          document.documentElement.setAttribute("data-platform-filter", platform);
        }
      } catch {}
    </script>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-B1W4WBHBGE"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-B1W4WBHBGE");
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={import.meta.env.BASE_URL} aria-label="ぶいちゃ配信アンテナ ホーム">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>ぶいちゃ配信アンテナ</span>
        </a>
        <p>最終更新: <time datetime={updatedAt}>{updatedLabel} JST</time></p>
      </div>
    </header>
    <main class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-note">
        <p>
          本サイトはすべての VRChat 配信者・コンテンツを網羅しているわけではありません。また、取得の仕組み上、VRChat
          以外のコンテンツが掲載されることがあります。掲載の削除をご希望の場合は
          X <a href="https://x.com/hir0chan_vrc" target="_blank" rel="noreferrer">@hir0chan_vrc</a>
          までご連絡ください。本サイトはアクセス状況の把握のため Google Analytics を使用しています。
        </p>
      </div>
      <div class="shell footer-inner">
        <p class="footer-author">
          <img
            class="footer-avatar"
            src="https://avatars.githubusercontent.com/u/311045925?v=4&s=64"
            alt=""
            width="32"
            height="32"
            loading="lazy"
          />
          ぶいちゃ配信アンテナ by hir0chan
          <span class="footer-links">
            <a href="https://x.com/hir0chan_vrc" target="_blank" rel="noreferrer" aria-label="X (hir0chan_vrc)">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.451-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644z" />
              </svg>
            </a>
            <a href="https://github.com/hir0chan" target="_blank" rel="noreferrer" aria-label="GitHub (hir0chan)">
              <svg viewBox="0 0 16 16" width="17" height="17" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
              </svg>
            </a>
          </span>
        </p>
      </div>
    </footer>
    <script is:inline>
      const controls = document.querySelector(".filter-controls");
      let initialized = false;
      const toggle = document.getElementById("ja-only-toggle");
      if (toggle instanceof HTMLInputElement) {
        initialized = true;
        toggle.checked = document.documentElement.hasAttribute("data-ja-only");
        toggle.addEventListener("change", () => {
          document.documentElement.toggleAttribute("data-ja-only", toggle.checked);
          try {
            if (toggle.checked) {
              localStorage.removeItem("vrsp-ja-only");
            } else {
              localStorage.setItem("vrsp-ja-only", "0");
            }
          } catch {}
        });
      }
      const platformFilters = document.querySelectorAll('input[name="platform-filter"]');
      if (platformFilters.length > 0) {
        initialized = true;
        const platform = document.documentElement.getAttribute("data-platform-filter") ?? "all";
        platformFilters.forEach((filter) => {
          if (!(filter instanceof HTMLInputElement)) return;
          filter.checked = filter.value === platform;
          filter.addEventListener("change", () => {
            if (!filter.checked) return;
            if (filter.value === "youtube" || filter.value === "twitch") {
              document.documentElement.setAttribute("data-platform-filter", filter.value);
              try {
                localStorage.setItem("vrsp-platform", filter.value);
              } catch {}
            } else {
              document.documentElement.removeAttribute("data-platform-filter");
              try {
                localStorage.removeItem("vrsp-platform");
              } catch {}
            }
          });
        });
      }
      if (initialized && controls instanceof HTMLElement) controls.hidden = false;
    </script>
  </body>
</html>
