---
import type { JoinedStream } from "../lib/classify.js";

interface Props {
  stream: JoinedStream;
  thumbnailUrl: string;
  live?: boolean;
}

const { stream, thumbnailUrl, live = false } = Astro.props;
const start = live ? stream.actualStart : stream.scheduledStart;
const startLabel =
  start === undefined
    ? undefined
    : new Intl.DateTimeFormat("ja-JP", {
        timeZone: "Asia/Tokyo",
        hour: "2-digit",
        minute: "2-digit",
      }).format(new Date(start));
---

<article class="stream-card">
  <a class="card-link" href={stream.url} target="_blank" rel="noreferrer" aria-label={`${stream.title}をYouTubeで見る`}>
    <div class="thumbnail-wrap">
      <img src={thumbnailUrl} alt="" width="1280" height="720" loading="lazy" />
      {live && <span class="live-badge"><span aria-hidden="true"></span>LIVE</span>}
      {startLabel !== undefined && <time datetime={start}>{startLabel}</time>}
    </div>
    <div class="stream-card-body">
      <p class="streamer-name">{stream.streamer.name}</p>
      <h3>{stream.title}</h3>
      <span class="card-action">配信ページへ <span aria-hidden="true">↗</span></span>
    </div>
  </a>
</article>
