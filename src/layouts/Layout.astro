---
import "../styles/global.css";
import type { Locale } from "../lib/i18n.js";
import { getTranslation } from "../lib/i18n.js";
import { supportUrl } from "../lib/site.js";

interface Props {
  locale: Locale;
  updatedAt: string;
}

const { locale, updatedAt } = Astro.props;
const t = getTranslation(locale);
const baseUrl = new URL(
  import.meta.env.BASE_URL,
  Astro.site ?? "https://hir0chan.github.io",
);
const jaUrl = baseUrl.href;
const enUrl = new URL("en/", baseUrl).href;
const pageUrl = locale === "ja" ? jaUrl : enUrl;
const currentHomePath = locale === "ja"
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}en/`;
const ogImageUrl = new URL("images/ogp.png", baseUrl).href;
const intlLocale = locale === "ja" ? "ja-JP" : "en-US";
const updatedLabel = new Intl.DateTimeFormat(intlLocale, {
  timeZone: "Asia/Tokyo",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  hourCycle: "h23",
}).format(new Date(updatedAt));
---

<!doctype html>
<html lang={locale} data-ja-only={locale === "ja" ? "" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={t.description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="ja" href={jaUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={jaUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={t.siteName} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === "ja" ? "ja_JP" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "ja" ? "en_US" : "ja_JP"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hir0chan_vrc" />
    <meta name="twitter:title" content={t.siteName} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href={`${import.meta.env.BASE_URL}images/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}images/favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}images/apple-touch-icon.png`} />
    <title>{t.title}</title>
    <script is:inline>
      // 保存値がない場合だけ、静的に描画したページ既定値を維持する。
      try {
        const jaOnly = localStorage.getItem("vrsp-ja-only");
        if (jaOnly === "1") {
          document.documentElement.setAttribute("data-ja-only", "");
        } else if (jaOnly === "0") {
          document.documentElement.removeAttribute("data-ja-only");
        }
      } catch {}
      try {
        const platform = localStorage.getItem("vrsp-platform");
        if (platform === "youtube" || platform === "twitch" || platform === "niconico") {
          document.documentElement.setAttribute("data-platform-filter", platform);
        }
      } catch {}
    </script>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-B1W4WBHBGE"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-B1W4WBHBGE");
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={currentHomePath} aria-label={t.brandAriaLabel}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span>{t.siteName}</span>
        </a>
        <div class="header-meta">
          <p class="header-updated">{t.updatedPrefix}<time datetime={updatedAt}>{updatedLabel} JST</time></p>
          <nav class="language-switch" aria-label="Language">
            {
              locale === "ja" ? (
                <span aria-current="page" aria-label="日本語">JA</span>
              ) : (
                <a href={import.meta.env.BASE_URL} aria-label="日本語">JA</a>
              )
            }
            {
              locale === "en" ? (
                <span aria-current="page" aria-label="English">EN</span>
              ) : (
                <a href={`${import.meta.env.BASE_URL}en/`} aria-label="English">EN</a>
              )
            }
          </nav>
        </div>
      </div>
    </header>
    <main class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-note">
        <p>
          {t.footerBeforeHandle}<a href="https://x.com/hir0chan_vrc" target="_blank" rel="noreferrer">@hir0chan_vrc</a>{t.footerAfterHandle}
        </p>
        {supportUrl !== "" && (
          <p class="support-note">
            <a href={supportUrl} target="_blank" rel="noreferrer">{t.supportLinkLabel} <span aria-hidden="true">↗</span></a>
          </p>
        )}
      </div>
      <div class="shell footer-inner">
        <p class="footer-author">
          <img
            class="footer-avatar"
            src="https://avatars.githubusercontent.com/u/311045925?v=4&s=64"
            alt=""
            width="32"
            height="32"
            loading="lazy"
          />
          {t.footerAuthor}
          <span class="footer-links">
            <a href="https://x.com/hir0chan_vrc" target="_blank" rel="noreferrer" aria-label="X (hir0chan_vrc)">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.451-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644z" />
              </svg>
            </a>
            <a href="https://github.com/hir0chan" target="_blank" rel="noreferrer" aria-label="GitHub (hir0chan)">
              <svg viewBox="0 0 16 16" width="17" height="17" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
              </svg>
            </a>
          </span>
        </p>
      </div>
    </footer>
    <script is:inline>
      const controls = document.querySelector(".filter-controls");
      let initialized = false;
      const toggle = document.getElementById("ja-only-toggle");
      if (toggle instanceof HTMLInputElement) {
        initialized = true;
        toggle.checked = document.documentElement.hasAttribute("data-ja-only");
        toggle.addEventListener("change", () => {
          document.documentElement.toggleAttribute("data-ja-only", toggle.checked);
          try {
            localStorage.setItem("vrsp-ja-only", toggle.checked ? "1" : "0");
          } catch {}
        });
      }
      const platformFilters = document.querySelectorAll('input[name="platform-filter"]');
      if (platformFilters.length > 0) {
        initialized = true;
        const platform = document.documentElement.getAttribute("data-platform-filter") ?? "all";
        platformFilters.forEach((filter) => {
          if (!(filter instanceof HTMLInputElement)) return;
          filter.checked = filter.value === platform;
          filter.addEventListener("change", () => {
            if (!filter.checked) return;
            if (filter.value === "youtube" || filter.value === "twitch" || filter.value === "niconico") {
              document.documentElement.setAttribute("data-platform-filter", filter.value);
              try {
                localStorage.setItem("vrsp-platform", filter.value);
              } catch {}
            } else {
              document.documentElement.removeAttribute("data-platform-filter");
              try {
                localStorage.removeItem("vrsp-platform");
              } catch {}
            }
          });
        });
      }
      if (initialized && controls instanceof HTMLElement) controls.hidden = false;
    </script>
  </body>
</html>
